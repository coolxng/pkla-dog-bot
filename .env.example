DISCORD_TOKEN=
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_CHAT_FALLBACK=false
ENABLE_OPENAI_WEB_SEARCH=false

# Optional browser voice receive. Keep false unless you intentionally enable the consent-gated feature.
ENABLE_LISTEN_IN=false
PUBLIC_BASE_URL=https://pkladog.up.railway.app

# Optional OpenAI-only feature settings
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=chat-latest

# Discord/server configuration
PING_MEMBERS_JSON=
EXTERNAL_CHANNEL_ID=
EXTERNAL_VOICE_CHANNEL_ID=1401382324326760672
EXTERNAL_SAY_CONTROL_TOKEN=

# Runtime / web server
PORT=3000
LOG_LEVEL=INFO
# gevent's WSGIServer needs gevent.monkey.patch_all() to run safely alongside
# discord.py's asyncio loop; this process doesn't do that, so leave this
# false and let the threaded Flask dev server handle /say/listen instead.
USE_PRODUCTION_WEB_SERVER=false
